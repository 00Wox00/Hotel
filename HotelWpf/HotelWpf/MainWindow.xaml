<Window x:Class="HotelWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelWpf"
        mc:Ignorable="d"
        Title="Гостиничный номер" Height="400" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Label Content="ID" Padding="0,10,0,0" HorizontalContentAlignment="Right"/>
            <Label Content="Номер" Height="30" Padding="0,15,0,0" HorizontalContentAlignment="Right"/>
            <Label Content="Категория" Height="30" Padding="0,14,0,0" HorizontalContentAlignment="Right"/>
            <Label Content="Цена за сутки" Height="30" Padding="0,11,0,0 " HorizontalContentAlignment="Right"/>
            <Label Content="Количество суток" Height="30" Padding="0,9,0,0" HorizontalContentAlignment="Right"/>
            <Label Content="Стоимость проживания" Height="30" Padding="0,12,0,0" HorizontalContentAlignment="Right"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Margin="5" Padding="0,5,0,5" Text="{Binding Id}"/>
            <TextBox Margin="5" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding PricePerDay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="5" Padding="0,5,0,5" Text="{Binding TotalCost}"/>

            <Button Margin="5" Content="Сохранить" Click="Save_Click"/>
            <Button Margin="5" Content="Новая запись" Click="NewRecord_Click"/>

            <Label Content="Поиск по ID"/>
            <TextBox x:Name="tbSearchId" Margin="5"/>
            <Button Margin="5" Content="Найти" Click="Find_Click"/>
        </StackPanel>
    </Grid>
</Window>